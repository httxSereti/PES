# Directory (relative to apps/app, where the app is run from)
DIR_BACKUP = backup
DIR_PROFILE = profile
DIR_TMP = tmp

# Chaster API
CHASTER_TOKEN = ''
CHASTER_URL = 'https://api.chaster.app'

JWT_SECRET_KEY = ""
FRONT_URL = ""

# Discord startup notification webhook
DISCORD_STARTUP_WEBHOOKS = ''

# Generic webhook connector
GENERIC_WEBHOOK_TOKEN = ''
# Allow WEBHOOK_SEND actions to reach private/loopback hosts (local n8n, ...)
WEBHOOK_ALLOW_PRIVATE = false

# Events v3 rollout (phase 0)
EVENTS_V3_ENABLED = false
EVENTS_V3_SHADOW_MODE = false
EVENTS_V3_TELEMETRY = false
EVENTS_V3_MAX_WORKERS = 4
# In-memory dedupe window for source-provided dedupe_key values
EVENTS_V3_DEDUPE_TTL_SECONDS = 300
# Delete flow runs/approvals older than N days at startup (0 = keep forever)
EVENTS_V3_RETENTION_DAYS = 0